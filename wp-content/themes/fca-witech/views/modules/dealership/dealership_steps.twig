<div class="steps">
  {% set steps = post.get_field('steps') %}
  {% if steps %}
    <ol>
      {% for step in steps %}
        <li class="steps__step">
          <span class="steps__title">{{ step.title }}</span>
          {% if step.documents %}
            <ul class="steps__documents">
              {% for document in step.documents %}
                <li>
                  <span class="{% if document.is_document == true %}document{% endif %}">
                    <a href="{{ document.link }}">{{ document.title }}</a>
                  </span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  {% endif %}
</div>
