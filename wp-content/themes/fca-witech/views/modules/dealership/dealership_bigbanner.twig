{% set img = TimberImage(post.get_field('bigbanner__image')) %}
<div class="bigbannerdealership" style="background-image: url('{{ img.src }}');">
	<div class="wrapper">
		<div class="bigbanner__content">
      {% if post.get_field('bigbanner__title') %}
			   <h1>{{ post.get_field('bigbanner__title') }}</h1>
      {% endif %}
      <h2>{{ post.get_field('bigbanner__content') }}</h2>
      {% if post.get_field('bigbanner__subtext') %}
			   <h4>{{ post.get_field('bigbanner__subtext') }}</h4>
      {% endif %}
		</div>
	</div>
</div>
