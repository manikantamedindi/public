<div class="documents">
  {% set documents__title = post.get_field('documents__title') %}
  <div class="documents__title">{{ documents__title }}</div>
  <div class="documents__list">
    {% set documents__document = post.get_field('documents__document') %}
    {% if documents__document %}
      {% for item in documents__document %}
        <div class="document_list_item">
          <h6><a href="{{ item.link }}">{{ item.title }}</a></h6>
          <h4>{{ item.description }}</h4>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>
