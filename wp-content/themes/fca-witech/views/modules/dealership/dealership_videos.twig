<div class="videos">
    {% set videos__title = post.get_field('videos__title') %}
    <h2 class="videos__title">{{ videos__title }}</h2>
    {% set videos__video = post.get_field('videos__video') %}
    {% if videos__video %}
      <div class="videos__video_wrap">
        {% for item in videos__video %}
            {% set img = TimberImage(item.img) %}
            <div class="videos__video">
                <div class="videos__video__thumb" style="position: relative; line-height: 0;">
                    <img class="videos__video__img" src="{{ img.src }}" alt="" style="width: 100%; display: block;" />
                    <a class="videos__video__button" data-youtube-id="{{ item.youtube_id }}"></a>
                </div>
                <h3 class="videos__video__title">{{ item.title }}</h3>
            </div>
        {% endfor %}
      </div>
    {% endif %}

