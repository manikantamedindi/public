{% set img = TimberImage(post.get_field('hero__image')) %}
<div class="hero" style="background-image: url('{{ img.src }}');">
	{% include 'fragments/header.twig' %}
	<div class="wrapper">
		{% set hero__text = post.get_field('hero__text') %}
		{% if hero__text %}
			<div class="hero__content">
				{% for item in hero__text %}
					<div{% if item.format == 'large' %} class="hero__content-large"{% endif %}>{{ item.content }}</div>
				{% endfor %}
				<a class="hero__content-play" id="hero-video-start" href="#"></a>
			</div>
		{% endif %}
	</div>
</div>
