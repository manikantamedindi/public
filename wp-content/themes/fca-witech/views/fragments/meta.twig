<!doctype html>
<html lang="en-US">
<head>
  <meta http-equiv="X-UA-Compatible" content="IE=11; IE=10; IE=9; IE=8; IE=7; IE=EDGE" />
  <meta charset="UTF-8" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {% if function('is_front_page') %}
    <title>{{ site.name }}</title>
  {% else %}
    <title>{{ wp_title }} | {{ site.name }}</title>
  {% endif %}

  <script src="{{ site.url }}/wp-content/themes/fca-witech/script.js"></script>
  <!--<script src="{{ site.url }}/wp-content/themes/fca-witech/fonts.compiled.js"></script></-->
  <!--<script>try{Typekit.load({ async: true });}catch(e){}</script></-->
  <script src="https://player.vimeo.com/api/player.js"></script>
  <script src="{{ site.url }}/wp-content/themes/fca-witech/bower_components/jquery/dist/jquery.min.js" type="text/javascript" charset="utf-8"></script>
  <script src="{{ site.url }}/wp-content/themes/fca-witech/bower_components/jquery-modal/jquery.modal.min.js" type="text/javascript" charset="utf-8"></script>
  <script>
    $(document).ready(function() {
      // Small timeout to let Vimeo script initialize
      setTimeout(function() {
        if ($('#hero-inline-video').length) {
          var player = new Vimeo.Player($('#hero-inline-video')[0]);
          var isPlaying = false; 
          var userManuallyPaused = false;
          var pausedByScroll = false;

          var $btn = $('#hero-video-start');
          // Start in loading state
          $btn.addClass('is-loading');

          // When video actually starts playing, remove loading and set to pause icon
          player.on('play', function() {
            $btn.removeClass('is-loading').addClass('is-playing');
            isPlaying = true;
          });

          // When video pauses, change icon to play
          player.on('pause', function() {
            $btn.removeClass('is-loading is-playing');
            isPlaying = false;
          });

          $btn.off('click').on('click', function(e) {
            e.preventDefault();
            if ($btn.hasClass('is-loading')) return; // do nothing if still loading

            if (isPlaying) {
              userManuallyPaused = true;
              pausedByScroll = false;
              player.pause();
            } else {
              userManuallyPaused = false;
              pausedByScroll = false;
              player.play();
            }
          });

          // Stop video on scroll if hero section ends
          var heroSection = $('#hero-inline-video').closest('.hero')[0] || $('.hero')[0];
          if (heroSection) {
            var handleSectionVisibility = function(isSectionEnded) {
              if (isSectionEnded) {
                // Section ended / scrolled out of view: stop video
                player.getPaused().then(function(paused) {
                  if (!paused) {
                    pausedByScroll = true;
                    player.pause().catch(function() {});
                  }
                }).catch(function() {
                  if (isPlaying) {
                    pausedByScroll = true;
                    player.pause().catch(function() {});
                  }
                });
              } else {
                // Section back in view: resume if it was paused by scrolling
                if (pausedByScroll && !userManuallyPaused) {
                  player.play().then(function() {
                    pausedByScroll = false;
                  }).catch(function() {});
                }
              }
            };

            if ('IntersectionObserver' in window) {
              var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                  handleSectionVisibility(!entry.isIntersecting);
                });
              }, { threshold: 0 });
              observer.observe(heroSection);
            }

            var ticking = false;
            $(window).on('scroll resize', function() {
              if (!ticking) {
                window.requestAnimationFrame(function() {
                  var rect = heroSection.getBoundingClientRect();
                  var isEnded = (rect.bottom <= 0 || rect.top >= window.innerHeight);
                  handleSectionVisibility(isEnded);
                  ticking = false;
                });
                ticking = true;
              }
            });
          }
        }
      }, 100);
    });
  </script>
  <link rel="stylesheet" href="{{ site.url }}/wp-content/themes/fca-witech/bower_components/jquery-modal/jquery.modal.css" type="text/css" media="screen" />


  {{ function('wp_head') }}
</head>
