<header class="header">
	<a href="{{ site.url }}"><img class="header__logo" alt="Mopar wiTECH 2" src="{{ theme.link }}/img/brand/logo.png" />
	<nav class="header__navigation" id="menu">
		{% for item in menu_main.get_items %}
			<a class="header__navigation-link" href="{{ item.get_link }}">{{ item.title }}</a>
		{% endfor %}
	</nav>
	<a class="header__toggle" href="#" id="menu-toggle">Menu</a>
</header>
